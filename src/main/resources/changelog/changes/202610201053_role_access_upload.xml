      </column>
      <column name="method" type="VARCHAR">
        <constraints nullable="false"/>
      </column>
      <column name="description" type="VARCHAR"/>
      <column name="roles" type="VARCHAR" />
      <column name="uploadstatus" type="VARCHAR" />
      <column name="errormessage" type="TEXT" />
      <column name="created" type="TIMESTAMP WITHOUT TIME ZONE"/>
      <column name="updated" type="TIMESTAMP WITHOUT TIME ZONE"/>
      <column name="createdby" type="VARCHAR(150)"/>
      <column name="updatedby" type="VARCHAR(150)"/>
    </createTable>
  </changeSet>
</databaseChangeLog>